# The generated local .env already contains a random password.
# When setting up another machine, copy this file to .env and set your password.
MINIO_ACCESS_KEY=retailadmin
MINIO_SECRET_KEY=replace-with-your-own-long-password
MINIO_REGION=us-east-1
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_BUCKET=bigdata

# Host notebook connection (containers use http://minio:9000 internally).
MINIO_ENDPOINT=http://127.0.0.1:19000
RETAIL_LAKE_ROOT=s3a://bigdata/retail_als

# Notebook: ./run_notebook.sh --source full|small; RUN_ID mặc định retail_star_<source>_v1.
# RETAIL_STAR_RUN_ID=retail_star_full_v1
RETAIL_DATA_REVISION=79bcf78cd4699267f561ad3fd51fe7b52af53083
RETAIL_JOB_MEMORY_MAX=7G
# Swap của job có hạn mức (RAM -> spill SSD -> swap dự phòng).
RETAIL_JOB_SWAP_MAX=4G
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=3g
SPARK_EXECUTOR_MEMORY=3g
RETAIL_GPU_HOST_BUDGET_GB=2.5
RETAIL_GPU_USER_BATCH=64
RETAIL_GPU_ITEM_BATCH=8192
RETAIL_GPU_CG_STEPS=5
